# ROUTPILOT ENVIRONMENT CONFIGURATION
# Managed via the AI Studio Secrets panel (never hardcode keys in source code).
# ESP32_HTTP_ENDPOINT and ESP32_WS_ENDPOINT are OPTIONAL.
# They are NOT required when Virtual Mode is selected (Default).
# Uncomment or set them in AI Studio Secrets when connecting physical ESP32 hardware:
# ESP32_HTTP_ENDPOINT=http://192.168.1.50/sensors
# ESP32_WS_ENDPOINT=ws://192.168.1.50:81/ws
ROUTPILOT_BACKEND_URL=http://10.0.2.2:8000
# GEMINI_API_KEY=MY_GEMINI_API_KEY
